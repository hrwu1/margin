# The backend automatically loads this project-root file as .env.
# Keep the real key only in .env; never prefix it with VITE_ or commit it.
OPENAI_API_KEY=
MARGIN_PROVIDER=openai
# Explicit offline fixtures: MARGIN_PROVIDER=mock (no network/model calls).
# MARGIN_DATABASE_PATH=/absolute/path/to/margin.sqlite3
MARGIN_MODEL_TIMEOUT=90
MARGIN_MAX_ACTIVE=4
# Set true when serving over HTTPS.
MARGIN_COOKIE_SECURE=false
